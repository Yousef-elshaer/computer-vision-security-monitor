# Camera and model
CAMERA_INDEX=0
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.45
DETECTION_STRIDE=3
AUTO_START=true

# Event and alert thresholds (0-100)
EVENT_THRESHOLD=35
ALERT_THRESHOLD=70
ALERT_COOLDOWN_SECONDS=90

# Twilio SMS. Keep dry-run enabled until the test alert looks right.
SMS_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
ALERT_TO_NUMBER=+15557654321

